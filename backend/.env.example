# Copier vers backend/.env et remplir. Ne jamais committer backend/.env.

NODE_ENV=development
PORT=5000

# MongoDB. En local via docker compose, le host est le nom du service : mongo
MONGO_URI=mongodb://127.0.0.1:27017/incloz

# Clé de signature des JWT. Générer une valeur longue et aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changer_cette_valeur

# Cloudinary — utilisé par POST /api/upload (réservé aux administrateurs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Plafonds de limitation de débit. Optionnels : les valeurs par défaut
# conviennent en production. Utiles pour tester le comportement en local.
# RATE_LIMIT_AUTH_MAX=10      # connexion + inscription, par tranche de 15 min
# RATE_LIMIT_FORM_MAX=5       # formulaire sur-mesure, par heure
# RATE_LIMIT_GLOBAL_MAX=300   # reste de l'API, par tranche de 15 min
