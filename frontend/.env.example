# Ces variables sont injectées au build par Vite et se retrouvent en clair
# dans le bundle : n'y mettre que des valeurs publiques, jamais de secret.
#
# frontend/.env contient les valeurs de production et est suivi par git.
# Pour surcharger en local, créer frontend/.env.local (ignoré par git) :
#
#   VITE_API_URL=http://localhost:5000/api
#   VITE_IMG_URL=http://localhost:5000/uploads
#
# Sans aucun fichier .env, src/config/api.js retombe sur localhost:5000.

VITE_API_URL=https://api.incloz.com/api
VITE_IMG_URL=https://api.incloz.com/uploads
