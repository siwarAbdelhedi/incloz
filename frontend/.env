VITE_API_URL=https://api.incloz.com/api
VITE_IMG_URL=https://api.incloz.com/uploads

# Adresse publique du site, utilisée pour construire les URL absolues des
# balises Open Graph d'index.html — Facebook comme LinkedIn ignorent une URL
# relative. Déduite de VITE_API_URL (api.incloz.com) : à confirmer, et à
# corriger ici si le site est servi depuis www.incloz.com ou un autre domaine.
VITE_SITE_URL=https://incloz.com
