{
  "name": "incloz",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Incloz — vêtements de sport adaptés pour parathlètes (API Express + front React)",
  "author": "Siwar",
  "license": "MIT",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
